{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommitTypeAll(build)", ":semanticCommitScope(deps)"],
  "semanticCommits": "enabled",
  "platformCommit": "enabled",
  "postUpdateOptions": ["gomodTidy", "gomodUpdateImportPaths"],
  "constraintsFiltering": "strict",
  "automergeType": "pr",
  "automergeStrategy": "squash",
  "platformAutomerge": false,
  "packageRules": [
    {
      "description": "Auto-merge non-major updates once all checks pass",
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true
    },
    {
      "description": "Keep the go directive unchanged, since it sets the minimum Go version required by consumers of this library",
      "matchDepNames": ["go"],
      "matchManagers": ["gomod"],
      "enabled": false
    },
    {
      "description": "The benchmark module uses the local copy of this module via a replace directive",
      "matchDepNames": ["github.com/pamburus/logftxt"],
      "enabled": false
    }
  ]
}
